{
  "name": "pi-date-tail",
  "version": "1.0.0",
  "description": "Tell the model what day it is without breaking pi's prompt cache: one short hidden message appended once per day, never the system prompt, and again after a compaction summarized it away.",
  "type": "module",
  "license": "MIT",
  "author": "Justin Barlow",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lobo235/pi-date-tail.git"
  },
  "homepage": "https://github.com/lobo235/pi-date-tail#readme",
  "bugs": {
    "url": "https://github.com/lobo235/pi-date-tail/issues"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "pi-coding-agent",
    "coding-agent",
    "llm",
    "ai-agents",
    "date",
    "timezone",
    "prompt-cache",
    "prompt-caching"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "image": "https://raw.githubusercontent.com/lobo235/pi-date-tail/v1.0.0/.github/assets/infographic.png"
  },
  "files": [
    "src/**/*.ts",
    "!src/**/*.test.ts",
    "!src/test-support.ts",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "npm run typecheck && node --test \"src/**/*.test.ts\" && npm run load-smoke && npm run smoke",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "load-smoke": "node load-smoke.mjs",
    "smoke": "node scripts/pi-smoke.ts",
    "check-pack": "node scripts/check-pack.ts"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.0.4",
    "@types/node": "24.19.1",
    "typescript": "5.9.3"
  }
}
